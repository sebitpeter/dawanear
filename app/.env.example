# Copy to .env and edit. EXPO_PUBLIC_* values are bundled INTO the app.
# Your laptop's Wi-Fi IP address (run ipconfig in PowerShell, look for IPv4 Address)
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Optional: search straight from the phone to Typesense.
# ONLY a SEARCH-ONLY key (actions: documents:search). Never the admin key.
EXPO_PUBLIC_TYPESENSE_HOST=
EXPO_PUBLIC_TYPESENSE_SEARCH_KEY=
